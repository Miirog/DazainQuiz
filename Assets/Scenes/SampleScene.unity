  - {fileID: 1876703311}
  resultImage: {fileID: 2066844760}
  _stepManager: {fileID: 696390125}
  _bgImage: {fileID: 1679700867}
  _bgColor: {fileID: 1781422850}
  _resultsImgDesktop:
  - {fileID: 8389134475083476877, guid: 2cb359e8e4865b74dac359bb9990dbd4, type: 3}
  - {fileID: -1540426309290004842, guid: ed152f14b4d53c245b10c37e3b3fbf48, type: 3}
  - {fileID: -6270953770400647376, guid: 114fd6c1678da5448a4fcaa847841025, type: 3}
  - {fileID: 4349915267927364619, guid: e8d934dd0389f3641bb840100f6d955a, type: 3}
  _resultsImgMobile:
  - {fileID: 1902317673384092583, guid: 6a1fb45cbf4052746972d172e3eb6ccf, type: 3}
  - {fileID: 75111626227767758, guid: d790302e5f831b5469d40e3e4bb46365, type: 3}
  - {fileID: -4200674580226939738, guid: f64dc6f9a2eb47a4cba6897dbc2a3dc8, type: 3}
  - {fileID: 5960680481146434440, guid: c0f8df68dd215e74c81681ce944c9978, type: 3}
  resultTextDesktop:
  - {fileID: 1541392115}
  - {fileID: 734255664}
  - {fileID: 1391426809}
  resultTextMobile:
  - {fileID: 730593075}
  - {fileID: 685349676}
  - {fileID: 853892204}
  _resultsTextsTitle:
  - "<b>Voc\xEA \xE9 o Orquestrador Visual</b>\\n\\n Voc\xEA transforma espa\xE7os
    em experi\xEAncias com alma. Seu olhar afiado cria ambientes que encantam pelo
    equil\xEDbrio entre forma e inten\xE7\xE3o. "
  - "<b>Voc\xEA \xE9 o Controlador de Miss\xE3o </b> \\n\\n Voc\xEA garante que tudo
    funcione do briefing ao p\xF3s-evento. \xC9 quem faz a roda girar  com clareza,
    organiza\xE7\xE3o e precis\xE3o. "
  - "<b>Voc\xEA \xE9 o Criador de Impacto</b>\\n\\n Voc\xEA quer causar. Seu evento
    \xE9 onde todo mundo para, grava, compartilha e comenta. "
  - "<b>Voc\xEA \xE9 o Cora\xE7\xE3o da Produ\xE7\xE3o</b>\\n\\n Voc\xEA faz com
    afeto. Est\xE1 atento \xE0s pessoas, emo\xE7\xF5es e mem\xF3rias criadas. "
  _resultsTextsDescription:
  - "Seu foco: est\xE9tica, coer\xEAncia, fluidez e identidade visual."
  - "Seu foco: execu\xE7\xE3o impec\xE1vel, planejamento s\xF3lido e entrega eficiente."
  - "Seu foco: impacto visual, inova\xE7\xE3o e viraliza\xE7\xE3o."
  - "Seu foco: v\xEDnculo emocional, prop\xF3sito e bem-estar."
  _resultsTextsDescription2:
  - "Ativa\xE7\xF5es ideais pra voc\xEA:\\n\\nProje\xE7\xE3o mapeada com narrativa
    visual\\n\\nTotens e interfaces com design autoral\\n\\nImpress\xE3o 3D para
    ambienta\xE7\xF5es exclusivas\\n\\nCenografia como linguagem da marca"
  - "Ativa\xE7\xF5es ideais pra voc\xEA:\\n\\nRealidade aumentada como ferramenta
    funcional\\n\\nSinaliza\xE7\xE3o e ambienta\xE7\xE3o organizacional\\n\\nBrindes
    personalizados com fun\xE7\xE3o estrat\xE9gica\\n\\nEstruturas modulares e log\xEDsticas
    bem definidas "
  - "Ativa\xE7\xF5es ideais pra voc\xEA:\\n\\nHolografia de alto impacto\\n\\nRealidade
    mista (digital + f\xEDsico)\\n\\nFOOh (fake out-of-home) e ativa\xE7\xF5es instagram\xE1veis\\n\\nGamifica\xE7\xE3o
    com storytelling envolvente "
  - "Ativa\xE7\xF5es ideais pra voc\xEA:\\n\\nRealidade virtual com narrativa imersiva\\n\\nEspa\xE7os
    de conviv\xEAncia com design afetivo\\n\\nSimuladores sensoriais e experi\xEAncias
    guiadas\\n\\nAnima\xE7\xF5es 3D com storytelling emocional "
  _simplifiedResultsTextsDescription:
  - Orquestrador Visual
  - "Controlador de Miss\xE3o"
  - Criador de Impacto
  - "Cora\xE7\xE3o da Produ\xE7\xE3o"
  _totalquestions:
  - {fileID: 72424596}
  - {fileID: 638192749}
